# Backend URL (used by the Streamlit frontend)
BACKEND_URL=http://localhost:8000

# Comma-separated list of allowed origins for CORS.
# Add your Streamlit Cloud URL here when deploying.
# Example: https://your-app.streamlit.app,http://localhost:8501
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Set to 1 to enable /docs (Swagger UI) — disable in production
ENABLE_DOCS=1
